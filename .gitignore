# Python bytecode / packaging artifacts
__pycache__/
*.pyc
*.egg-info/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated / downloaded data — raw, validated, features, and source CSV
# are all produced or downloaded at runtime, never source-controlled.
data/

# Personal interview prep notes — local only, never pushed.
interview/

# MLflow tracking store / artifact root — generated at runtime by the
# churn_model asset and its tests, never source-controlled.
mlflow.db
mlruns/

# Drift report HTML — generated at runtime by the drift_report asset,
# never source-controlled.
reports/

# Local virtual environment — created only to generate requirements-lock.txt
# from a clean dependency closure, not the global interpreter. Never
# source-controlled.
.venv/

# graphify output — local only, never pushed
graphify-out/

# Agent tooling — local only, never pushed
.claude/
.agents/
.scratch/
.hallmark/

# Step-by-step build plans — local reference, never pushed
docs/planning/plans/
