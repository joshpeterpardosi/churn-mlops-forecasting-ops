# Python bytecode / packaging artifacts
__pycache__/
*.pyc
*.egg-info/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Generated / downloaded data — raw, validated, features, and source CSV
# are all produced or downloaded at runtime, never source-controlled.
data/

# Personal interview prep notes — local only, never pushed.
interview/

# MLflow tracking store / artifact root — generated at runtime by the
# churn_model asset and its tests, never source-controlled.
mlflow.db
mlruns/

# Drift report HTML — generated at runtime by the drift_report asset,
# never source-controlled.
reports/
